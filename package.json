{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier — the house workspace. Sales and production for every product we build. Phase 1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "local:setup": "cross-env ATELIER_LOCAL_DB=true tsx scripts/local-setup.ts && cross-env ATELIER_LOCAL_DB=true tsx src/db/seed.ts",
    "local": "cross-env ATELIER_LOCAL_DB=true ATELIER_DEV_LOGIN=true AUTH_SECRET=atelier-local-development-only-secret-1a2b3c4d5e6f next dev",
    "local:reset": "node -e \"require('fs').rmSync('.atelier-local',{recursive:true,force:true})\" && npm run local:setup"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.4",
    "drizzle-orm": "^0.45.2",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
