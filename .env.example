# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. From Supabase: Project Settings -> Database -> Connection string.
# Use the POOLED connection (port 6543) for DATABASE_URL and the DIRECT
# connection (port 5432) for DIRECT_URL — Prisma migrations need the direct one.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=""
# In production set this to your real URL, e.g. https://crm.pagapro.com
AUTH_URL="http://localhost:3000"

# Magic-link email, via Resend (https://resend.com — free tier is plenty).
AUTH_RESEND_KEY=""
EMAIL_FROM="Atelier <crm@yourdomain.com>"

# Google sign-in. Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: comma-separated list of email domains allowed to sign in.
# Leave blank to allow any invited address.
ALLOWED_EMAIL_DOMAINS=""
