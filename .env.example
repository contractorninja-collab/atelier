# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. From Supabase: Connect -> Direct.
#
# Use the SESSION POOLER (port 5432) for BOTH of these. Two hard-won notes:
#
#   1. The direct host (db.<ref>.supabase.co) is IPv6-only. On an IPv4 network
#      it will not resolve at all, which looks like a wrong password.
#   2. Do not use the transaction pooler (6543) for DATABASE_URL, despite it
#      being the usual serverless advice. Drizzle's relational queries fan out
#      in parallel and transaction mode handles that badly on the free tier:
#      measured here, a batch of seven parallel queries hung 4 times out of 4
#      on 6543 and succeeded 4 out of 4 at ~450ms on 5432. If you revisit this,
#      measure it rather than trusting the convention.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=""
# In production set this to your real URL, e.g. https://crm.pagapro.com
AUTH_URL="http://localhost:3000"

# Magic-link email, via Resend (https://resend.com — free tier is plenty).
AUTH_RESEND_KEY=""
EMAIL_FROM="Atelier <crm@yourdomain.com>"

# Google sign-in. Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: comma-separated list of email domains allowed to sign in.
# Leave blank to allow any invited address.
ALLOWED_EMAIL_DOMAINS=""
